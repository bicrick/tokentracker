    "/users/{handle}/heatmap": {
      "get": {
        "summary": "Calendar heatmap grid",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "bicrick"
            }
          },
          {
            "name": "range",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "30d"
            },
            "description": "all | ytd | Nd (e.g. 30d) | YYYY"
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive start day; overrides range"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive end day"
          },
          {
            "name": "tools",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "claude-code,codex"
            },
            "description": "Comma-separated tool ids"
          },
          {
            "name": "models",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "anthropic/claude-opus-5-5"
            },
            "description": "Comma-separated model ids"
          },
          {
            "name": "levels",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 2,
              "maximum": 10,
              "default": 5
            }
          },
          {
            "name": "weekStart",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "sun",
                "mon"
              ],
              "default": "sun"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Heatmap"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
