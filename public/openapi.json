  "components": {
    "responses": {
      "BadRequest": {
        "description": "Invalid parameter",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Unknown user or resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Totals": {
        "type": "object",
        "properties": {
          "tokens": {
            "type": "integer"
          },
          "input": {
            "type": "integer"
          },
          "output": {
            "type": "integer"
          },
          "reasoning": {
            "type": "integer"
          },
          "cacheRead": {
            "type": "integer"
          },
          "cacheWrite": {
            "type": "integer"
          },
          "responses": {
            "type": "integer"
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "totals": {
            "$ref": "#/components/schemas/Totals"
          },
          "thisYear": {
            "$ref": "#/components/schemas/Totals"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "models": {
            "type": "integer"
          },
          "devices": {
            "type": "integer"
          },
          "firstDay": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "lastDay": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "lastSync": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "links": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "UsageRow": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Totals"
          },
          {
            "type": "object",
            "properties": {
              "period": {
                "type": "string",
                "description": "YYYY-MM-DD (day/week start), YYYY-MM, YYYY or total"
              },
              "split": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              }
            }
          }
        ]
      },
      "Usage": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string"
          },
          "split": {
            "type": [
              "string",
              "null"
            ]
          },
          "totals": {
            "$ref": "#/components/schemas/Totals"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsageRow"
            }
          }
        }
      },
      "Model": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Totals"
          },
          {
            "type": "object",
            "properties": {
              "model": {
                "type": "string"
              },
              "provider": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "share": {
                "type": "number"
              },
              "firstUsed": {
                "type": "string",
                "format": "date"
              },
              "lastUsed": {
                "type": "string",
                "format": "date"
              }
            }
          }
        ]
      },
      "ModelList": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Model"
            }
          }
        }
      },
      "Tool": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Totals"
          },
          {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "share": {
                "type": "number"
              },
              "models": {
                "type": "integer"
              },
              "firstUsed": {
                "type": "string",
                "format": "date"
              },
              "lastUsed": {
                "type": "string",
                "format": "date"
              }
            }
          }
        ]
      },
      "ToolList": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          }
        }
      },
      "HeatmapDay": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "level": {
            "type": "integer"
          }
        }
      },
      "Heatmap": {
        "type": "object",
        "properties": {
          "range": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "last": {
                "type": "string"
              }
            }
          },
          "levels": {
            "type": "integer"
          },
          "weekStart": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "activeDays": {
            "type": "integer"
          },
          "months": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "week": {
                  "type": "integer"
                }
              }
            }
          },
          "weeks": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "$ref": "#/components/schemas/HeatmapDay"
              }
            }
          }
        }
      },
      "Stats": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Totals"
          },
          {
            "type": "object",
            "properties": {
              "activeDays": {
                "type": "integer"
              },
              "firstDay": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lastDay": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "busiestDay": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "date": {
                    "type": "string"
                  },
                  "tokens": {
                    "type": "integer"
                  }
                }
              },
              "longestStreak": {
                "type": "integer"
              },
              "currentStreak": {
                "type": "integer"
              },
              "averagePerActiveDay": {
                "type": "integer"
              },
              "today": {
                "type": "integer"
              },
              "thisMonth": {
                "type": "integer"
              },
              "topTool": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "topModel": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        ]
      },
      "Device": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Totals"
          },
          {
            "type": "object",
            "properties": {
              "device": {
                "type": "string"
              },
              "tools": {
