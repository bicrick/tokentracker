{
  "openapi": "3.1.0",
  "info": {
    "title": "tokentracker API",
    "version": "1.0.0",
    "description": "Public, keyless API for AI coding token usage by day, model, tool and machine.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "https://tokentracker-nu.vercel.app/api/v1"
    }
  ],
  "paths": {
    "/users/{handle}": {
      "get": {
        "summary": "Profile summary",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "bicrick"
            }
          },
          {
            "name": "range",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "30d"
            },
            "description": "all | ytd | Nd (e.g. 30d) | YYYY"
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive start day; overrides range"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive end day"
          },
          {
            "name": "tools",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "claude-code,codex"
            },
            "description": "Comma-separated tool ids"
          },
          {
            "name": "models",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "anthropic/claude-opus-5-5"
            },
            "description": "Comma-separated model ids"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/users/{handle}/usage": {
      "get": {
        "summary": "Usage over time",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "bicrick"
            }
          },
          {
            "name": "range",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "30d"
            },
            "description": "all | ytd | Nd (e.g. 30d) | YYYY"
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive start day; overrides range"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive end day"
          },
          {
            "name": "tools",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "claude-code,codex"
            },
            "description": "Comma-separated tool ids"
          },
          {
            "name": "models",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "anthropic/claude-opus-5-5"
            },
            "description": "Comma-separated model ids"
          },
          {
            "name": "group",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month",
                "year",
                "total"
              ],
              "default": "day"
            }
          },
          {
            "name": "split",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "tool",
                "model"
              ]
            }
          },
          {
            "name": "fill",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Include empty days in daily series"
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
