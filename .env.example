# Postgres connection string (set automatically by the Neon integration on Vercel)
DATABASE_URL=

# Comma-separated device keys allowed to upload usage. Generate with: openssl rand -hex 24
TOKENTRACK_INGEST_KEYS=

# Account the data belongs to, and the public Cursor profile handle to pull from
TOKENTRACK_ACCOUNT=bicrick
CURSOR_HANDLE=bicrick

# Vercel sends this as a bearer token to cron routes
CRON_SECRET=
