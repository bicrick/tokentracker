{
  "name": "tokentracker",
  "version": "0.1.0",
  "description": "Track AI token usage across tools and devices. Only daily totals leave your machine.",
  "license": "MIT",
  "type": "module",
  "repository": "github:bicrick/tokentracker",
  "bin": {
    "tokentrack": "cli/tokentrack.js"
  },
  "files": [
    "cli"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vercel dev",
    "sync": "node --use-system-ca --disable-warning=ExperimentalWarning cli/tokentrack.js sync",
    "sync:dry": "node --use-system-ca --disable-warning=ExperimentalWarning cli/tokentrack.js sync --dry",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0"
  },
  "devDependencies": {
    "vercel": "^66.2.0"
  }
}
