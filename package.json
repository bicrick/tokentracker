{
  "name": "@bicrick/tokentracker",
  "version": "0.7.2",
  "description": "Track AI coding token usage (Claude Code, Cursor, Codex, OpenCode, Gemini CLI, Copilot and more) in your own GitHub repo, served as a free public API on GitHub Pages.",
  "keywords": [
    "ai",
    "ai-coding",
    "ai-usage",
    "analytics",
    "anthropic",
    "api",
    "claude",
    "claude-code",
    "cli",
    "cline",
    "codex",
    "copilot",
    "copilot-cli",
    "cursor",
    "dashboard",
    "deepseek",
    "developer-tools",
    "gemini-cli",
    "github-copilot",
    "github-pages",
    "heatmap",
    "kilo-code",
    "llm",
    "llm-usage",
    "openai",
    "opencode",
    "roo-code",
    "token-counter",
    "token-tracker",
    "token-usage",
    "tokens",
    "usage-stats",
    "usage-tracking"
  ],
  "homepage": "https://tokentracker.patrickbrown.dev",
  "bugs": {
    "url": "https://github.com/bicrick/tokentracker/issues"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bicrick/tokentracker.git"
  },
  "bin": {
    "tokentrack": "cli/tokentrack.js"
  },
  "files": [
    "cli"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --use-system-ca --watch-path=scripts scripts/dev-server.js",
    "sync": "node --use-system-ca --disable-warning=ExperimentalWarning cli/tokentrack.js sync",
    "sync:dry": "node --use-system-ca --disable-warning=ExperimentalWarning cli/tokentrack.js sync --dry",
    "deploy": "vercel --prod",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "devDependencies": {
    "vercel": "^66.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
