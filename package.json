{
  "name": "@bicrick/tokentracker",
  "version": "0.5.3",
  "description": "Your AI coding token usage as an API, stored in your own GitHub repo. Claude Code, Codex, Cursor, OpenCode, Gemini CLI and more.",
  "keywords": [
    "ai",
    "llm",
    "tokens",
    "token-usage",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "gemini-cli",
    "copilot",
    "cli",
    "github-pages",
    "api"
  ],
  "homepage": "https://tokentracker.patrickbrown.dev",
  "bugs": {
    "url": "https://github.com/bicrick/tokentracker/issues"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bicrick/tokentracker.git"
  },
  "bin": {
    "tokentrack": "cli/tokentrack.js"
  },
  "files": [
    "cli"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --use-system-ca --watch-path=scripts scripts/dev-server.js",
    "sync": "node --use-system-ca --disable-warning=ExperimentalWarning cli/tokentrack.js sync",
    "sync:dry": "node --use-system-ca --disable-warning=ExperimentalWarning cli/tokentrack.js sync --dry",
    "deploy": "vercel --prod",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "devDependencies": {
    "vercel": "^66.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
