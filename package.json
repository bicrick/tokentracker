{
  "name": "@bicrick/tokentracker",
  "version": "0.1.1",
  "description": "Track AI token usage across tools and devices. Only daily totals leave your machine.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bicrick/tokentracker.git"
  },
  "bin": {
    "tokentrack": "cli/tokentrack.js"
  },
  "files": [
    "cli"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --use-system-ca --watch-path=scripts scripts/dev-server.js",
    "sync": "node --use-system-ca --disable-warning=ExperimentalWarning cli/tokentrack.js sync",
    "sync:dry": "node --use-system-ca --disable-warning=ExperimentalWarning cli/tokentrack.js sync --dry",
    "deploy": "vercel --prod",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0"
  },
  "devDependencies": {
    "vercel": "^66.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
