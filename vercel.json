{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/v1/users/:handle", "destination": "/api/v1?handle=:handle&resource=profile" },
    { "source": "/api/v1/users/:handle/:resource", "destination": "/api/v1?handle=:handle&resource=:resource" },
    { "source": "/u/:handle", "destination": "/u" }
  ],
  "headers": [
    {
      "source": "/(llms.txt|llms-full.txt|openapi.json)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/cursor", "schedule": "0 * * * *" }
  ]
}
